<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Precise location is requested at runtime; coarse is declared because Android 12+
       requires it alongside fine and lets the user choose "approximate". -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Required for foregroundServiceType="location" on Android 14 (API 34) and later. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- Runtime permission on Android 13+; tracking still works if denied, the notification is just hidden. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Run/walk interval cues buzz at each switch (normal permission, no prompt). -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!-- ACCESS_BACKGROUND_LOCATION is intentionally NOT declared. Tracking always starts from a
       user action while the app is visible, so the location foreground service keeps
       "while-in-use" access after the screen is locked. -->

  <!-- Android 11+ only lets the app see the text-to-speech engine (spoken interval cues) when
       it declares that it looks for one. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.androidlocation.TrackingService"
      android:exported="false"
      android:foregroundServiceType="location" />

    <!-- Home-screen widget: today's distance, the daily goal and start buttons. -->
    <receiver
      android:name="expo.modules.androidlocation.StrideWidgetProvider"
      android:exported="true"
      android:label="@string/stride_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/stride_widget_info" />
    </receiver>
  </application>
</manifest>
