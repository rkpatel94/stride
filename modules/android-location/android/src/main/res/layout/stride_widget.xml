<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stride_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stride_widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stride_widget_today"
        android:textAllCaps="true"
        android:textColor="@color/stride_widget_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stride_widget_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="0.00 km"
        android:textColor="@color/stride_widget_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/stride_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/stride_widget_progress" />

    <TextView
        android:id="@+id/stride_widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/stride_widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/stride_widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/stride_widget_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Spacer. Widgets can only use RemoteViews classes, so a FrameLayout rather than a View. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/stride_widget_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stride_widget_walk"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/stride_widget_button_walk"
            android:gravity="center"
            android:text="@string/stride_widget_walk"
            android:textColor="@color/stride_widget_walk"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stride_widget_run"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/stride_widget_button_run"
            android:gravity="center"
            android:text="@string/stride_widget_run"
            android:textColor="@color/stride_widget_run"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/stride_widget_open"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/stride_widget_button_open"
        android:gravity="center"
        android:text="@string/stride_widget_open"
        android:textColor="@color/stride_widget_on_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
